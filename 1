#!/data/data/com.termux/files/usr/bin/sh
work_dir=$(mktemp -d -t void-XXXXXX)
stage1="$work_dir/stage1"
stage2="$work_dir/stage2"
final="$work_dir/final"

echo -n "" > "$stage1"

count=1
while [ $count -le 5 ]; do
    if ! xxd -p -r "$stage1" > "$stage1.tmp"; then
        echo "\033[38;5;196m[DECRYPT_FAILED] 第$count层16进制解密失败\033[0m"
        rm -rf "$work_dir"
        exit 1
    fi
    mv "$stage1.tmp" "$stage1"
    count=$((count + 1))
done

if ! base64 -d "$stage1" > "$stage2"; then
    echo "\033[38;5;196m[DECRYPT_FAILED] 第1层Base64解密失败\033[0m"
    rm -rf "$work_dir"
    exit 1
fi
if ! base64 -d "$stage2" > "$final"; then
    echo "\033[38;5;196m[DECRYPT_FAILED] 第2层Base64解密失败\033[0m"
    rm -rf "$work_dir"
    exit 1
fi

/data/data/com.termux/files/usr/bin/sh "$final" "$0"
rm -rf "$work_dir"
